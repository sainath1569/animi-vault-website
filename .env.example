# ── Supabase (Project Settings → API Keys) ───────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Connect → Session pooler. URL-encode special characters in the password (@ → %40).
# Only needed to run `npm run db:migrate`.
DATABASE_URL=

# ── Scraper ──────────────────────────────────────
SCRAPER_BASE_URL=https://animevault.up.railway.app
# Sent as x-api-key; lets the app skip the scraper's 60 req/min limit once the scraper is patched.
SCRAPER_API_KEY=

# ── App ──────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The account with this email becomes admin (applied by `npm run db:migrate`).
ADMIN_EMAIL=

# ── Upstash Redis (optional shared cache) ────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
